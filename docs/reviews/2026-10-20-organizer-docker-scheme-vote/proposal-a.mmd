flowchart TD
    ZIP["До отправки: проверить ZIP<br/>Только корневые .py и requirements.txt<br/>Промпты и схемы внутри своего кода<br/>Нет библиотек, весов и вложенных модулей"]
    SEND["Внешняя процедура разработки<br/>Не более 3 отправок в день, сброс 00:00 МСК<br/>Ждать любой score предыдущей<br/>Лучший public-код сохраняется для private"]
    START["Организатор запускает solution.py<br/>Сразу t0: дедлайн 10800 секунд<br/>argv: путь task.md, иначе task.md<br/>Чистое состояние одной задачи"]
    ENV["Docker организатора: Python 3.12<br/>8 CPU, 32 GB RAM, без заявленного GPU<br/>Только установленные разрешённые пакеты<br/>Без root, своего Docker, pip, Git, скачиваний"]
    SPEC["Прочитать task.md и текущие CSV<br/>train, test, словарь, sample_submission<br/>Тип, target, ID, метрика и выход<br/>UTF-8; фактическая схема словаря"]
    KNOWN{"Контракт выхода<br/>однозначно восстановлен?"}
    FAIL["Неразрешимый контракт или нет CSV<br/>Зафиксировать неуспех<br/>Универсальный результат не обещать"]
    BASE["Сразу дешёвый форматный резерв<br/>По текущему train и контракту<br/>Проверить строки, ID, типы, значения<br/>Атомарно сохранить submission.csv"]
    PROFILE["Профиль и фиксированный split<br/>Время, группы или IID; seeds и классы<br/>Все обучаемые преобразования только fit<br/>Если можно: отдельный confirmation"]
    EXACT{"Точная метрика и<br/>адаптер задачи поддержаны?"}
    API["Проверить разрешённый Qwen-канал<br/>OPENAI_MODEL, API_KEY, BASE_URL<br/>Ключ пока не выдан; tools / JSON неизвестны<br/>Проверка и запросы входят в срок"]
    MODE{"Подтверждён рабочий<br/>формат действий Qwen?"}
    DEGRADED["Завершить с сохранённым резервом<br/>Без proxy вместо неизвестной метрики<br/>API / задача не поддержаны: ограничение<br/>Успешный AutoResearch не заявлять"]
    BUDGET{"Есть время и ресурсы на опыт<br/>с запасом на CSV и остановку?<br/>Иначе заморозить поиск"}
    PLAN["Qwen: гипотеза и действие с аргументами<br/>draft / debug / improve по дереву опытов<br/>Алгоритм, признаки, обработка, ансамбль<br/>Получает измерения и ошибки скрипта"]
    CHECK["Скрипт проверяет действие и рецепт<br/>Схемы и диспетчер свои, без MCP<br/>Только разрешённые данные и операции<br/>Повторы, сложность, бюджет и зависимости"]
    GEN["Скрипт генерирует исполняемый Python<br/>Из ограниченного рецепта и операторов<br/>Модели и признаки меняются по гипотезе<br/>Произвольный Python модели не исполняется"]
    RUN["Дочерний опыт: свой cwd и процессы<br/>Один опыт; предел потоков, timeout<br/>psutil: память, диск и потомки best effort<br/>Это не OS sandbox, cgroup не требуется"]
    EVAL["Доверенный trainer / evaluator<br/>Сам задаёт fit / predict и считает метрику<br/>Не доверяет score из stdout<br/>Нет test-labels или платформенного feedback"]
    LOG["Журнал дерева опытов<br/>Код, рецепт, parent, split, seeds и версии<br/>Метрика, ошибки, время, RAM и артефакты<br/>После сбоя остановить потомков"]
    BETTER{"Корректный завершённый опыт<br/>лучше на том же протоколе?"}
    TEST["Получить test-предсказания кандидата<br/>Время на predict и CSV включено в бюджет<br/>Сохранить отдельный проверенный CSV<br/>При сбое оставить текущий submission"]
    PROMOTE["Продвигать только с готовым CSV<br/>Атомарная замена submission.csv<br/>Предыдущие лидеры и резерв сохранены<br/>Ошибки публикации ведут к откату"]
    FREEZE["Заморозить shortlist и правила выбора<br/>Рецепты, пороги, веса больше не меняются<br/>Confirmation ранее не обучал и не направлял поиск"]
    CONFIRM["Если хватает данных и времени<br/>Однократно проверить замороженный shortlist<br/>На исключённом confirmation<br/>Иначе выбрать по поисковой валидации"]
    SELECT["Выбрать финалиста и его готовый CSV<br/>Проверить и атомарно восстановить<br/>При ошибке откат к валидному лидеру<br/>Сохранить CSV перед любым refit"]
    REFITQ{"Есть измеренный запас<br/>на полный refit, predict,<br/>проверку и остановку?"}
    REFIT["Необязательный refit с watchdog<br/>На всех разрешённых train-данных<br/>Успех: временный новый CSV<br/>Сбой / timeout: старый CSV остаётся"]
    FINAL["Финальная проверка нового CSV<br/>Колонки, строки, ID, типы, классы / вероятности<br/>Конечность значений и формат sample<br/>Валиден: атомарная замена; иначе откат"]
    OUT["submission.csv существует до kill<br/>Рядом с solution.py и task.md<br/>После refit нет новой независимой оценки<br/>Освободить процессы и завершить вовремя"]
    POLICY["Ресурсы и данные всего запуска<br/>Пишем в cwd / подкаталоги / tmp<br/>30–35 GB: ориентир, проверять остаток<br/>С нуля разрешено; pretrained запрещены<br/>На перенос отдельных весов не рассчитывать"]
    ZIP --> SEND --> START --> ENV --> SPEC --> KNOWN
    KNOWN -->|Нет после сверки| FAIL
    KNOWN -->|Да| BASE
    BASE -->|Не удалось| FAIL
    BASE -->|CSV готов| PROFILE --> EXACT
    EXACT -->|Нет| DEGRADED --> OUT
    EXACT -->|Да| API --> MODE
    MODE -->|Нет или API недоступен| DEGRADED
    MODE -->|Native tools либо проверенный текстовый протокол| BUDGET
    BUDGET -->|Да| PLAN --> CHECK
    CHECK -->|Допустимо| GEN --> RUN
    CHECK -->|Отклонено| LOG
    RUN -->|Успех| EVAL --> LOG
    RUN -->|Ошибка, timeout, OOM| LOG
    LOG --> BETTER
    LOG -.->|Результат действия и история| PLAN
    BETTER -->|Нет| BUDGET
    BETTER -->|Да| TEST
    TEST -->|Валидный CSV| PROMOTE --> BUDGET
    TEST -->|Сбой| LOG
    BUDGET -->|Нет или Qwen исчерпан| FREEZE --> CONFIRM --> SELECT --> REFITQ
    REFITQ -->|Да| REFIT --> FINAL --> OUT
    REFITQ -->|Нет| OUT
    ENV -.-> POLICY
    POLICY -.-> CHECK
