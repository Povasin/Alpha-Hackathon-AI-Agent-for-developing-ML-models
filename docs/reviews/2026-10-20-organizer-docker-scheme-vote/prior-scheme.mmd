flowchart TD
    START["Запуск solution.py<br/>Начало общего дедлайна: 3 часа<br/>Рабочий каталог — папка задачи"]
    ENV["Окружение<br/>Python 3.12 · 8 CPU · 32 GB RAM<br/>Пакеты — по requirement.txt<br/>Запись: рабочий каталог и /tmp<br/>Без Git, pip и скачивания моделей"]
    QWEN["Qwen 3.8<br/>Ключ ожидаем от организаторов<br/>После получения: проверить endpoint,<br/>tool calling и ограничения API"]
    SPEC["TaskSpec с источниками и версиями<br/>Тип задачи, target, ID, метрика,<br/>параметры оценки и формат предсказаний<br/>Сверка task.md, словаря и CSV"]
    CONTRACT{"Выходной контракт<br/>определён однозначно?"}
    PROFILE["Профиль данных и ValidationSpec<br/>Выборочное чтение + потоковые проверки<br/>Split по смыслу задачи: время / группы / IID<br/>Фиксируем индексы, классы и seeds<br/>При возможности выделяем confirmation"]
    BASE["Ранний резервный результат<br/>Дешёвый адаптер поддерживаемой задачи<br/>Проверить и сохранить submission.csv<br/>Не объявлять его качество доказанным"]
    METRIC{"Точная метрика<br/>и evaluator поддержаны?"}
    START --> ENV --> SPEC --> CONTRACT
    QWEN -.->|Помощь в интерпретации| SPEC
    CONTRACT -->|Да| PROFILE --> BASE --> METRIC
    subgraph LOOP["AutoResearch — собственный runtime и дерево экспериментов"]
        BUDGET{"Следующий опыт помещается<br/>в остаток времени с резервом?"}
        PLAN["Планировщик гипотез<br/>Qwen или локальный резервный контроллер<br/>Выбор draft / debug / improve<br/>Учитываем ошибки, стоимость и историю"]
        RECIPE["Проверенный рецепт эксперимента<br/>Модель, признаки, обработка и параметры<br/>Проверка допустимости и повторов<br/>Генерация Python из разрешённых операторов"]
        RUN["Контролируемое исполнение<br/>Отдельный каталог и группа процессов<br/>Лимиты потоков, памяти, времени и логов<br/>Обработка ошибок, timeout и OOM"]
        EVAL["Доверенный trainer / evaluator<br/>Сам управляет fit и predict по split<br/>Обучаемые преобразования — внутри fit-части<br/>Сам считает метрику и проверяет предсказания<br/>Score из stdout не принимается"]
        JOURNAL["Журнал всех результатов<br/>Гипотеза, parent, рецепт и версии<br/>Метрика, статус, время, память, артефакты<br/>Отдельно: ухудшение, ошибка и неполный опыт<br/>Компактная сводка для планировщика"]
        BETTER{"Завершённый корректный опыт<br/>лучше текущего лидера<br/>на совместимом протоколе?"}
        SAVE["Подготовить test-предсказания кандидата<br/>Проверить CSV и сохранить артефакты<br/>Атомарно обновить submission.csv<br/>Лидер поиска пока предварительный"]
        BUDGET -->|Да| PLAN --> RECIPE
        RECIPE -->|Допустим| RUN --> EVAL --> JOURNAL --> BETTER
        RECIPE -->|Ошибка рецепта или повтор| JOURNAL
        BETTER -->|Да| SAVE --> BUDGET
        BETTER -->|Нет, включая сбой| BUDGET
        JOURNAL -.->|Измерения и отрицательные результаты| PLAN
    end
    METRIC -->|Да| BUDGET
    QWEN -.->|Если API доступен| PLAN
    subgraph FINISH["Подтверждение и завершение"]
        SHORTLIST["Заморозить короткий список финалистов<br/>Зафиксировать рецепты, пороги и веса"]
        CONFIRM["Подтверждающая проверка, если позволяет бюджет<br/>Один раз на исключённом из поиска confirmation<br/>Либо дополнительные допустимые folds<br/>При неустойчивом выигрыше предпочесть простоту"]
        SELECT["Выбрать финалиста<br/>Восстановить и проверить его готовый CSV<br/>Сохранить его до попытки refit"]
        REFIT["Опциональный refit на всём разрешённом train<br/>Только если fit + predict + запись помещаются<br/>Внешний watchdog обязателен<br/>При сбое остаётся сохранённый CSV"]
        FINAL["Финальная проверка<br/>Колонки, строки, порядок ID, типы,<br/>классы, вероятности и конечность значений<br/>Новый CSV заменяет старый только после проверки"]
        OUTPUT["submission.csv готов до дедлайна<br/>Рядом с solution.py и task.md"]
        RESERVE["Завершение с форматным резервом<br/>Метрика не подменяется другой<br/>Выбор лучшего по качеству не заявляется"]
        FAIL["Неразрешимый контракт<br/>или исчерпаны резервные пути<br/>Зафиксировать причину неуспешного запуска"]
        SHORTLIST --> CONFIRM --> SELECT --> REFIT --> FINAL --> OUTPUT
        RESERVE --> OUTPUT
    end
    BUDGET -->|Нет: пора завершать| SHORTLIST
    METRIC -->|Нет| RESERVE
    CONTRACT -->|Нет после повторной проверки| FAIL
    BASE -->|Допустимый CSV получить не удалось| FAIL
    classDef pending stroke-dasharray: 6 4;
    class QWEN pending;
