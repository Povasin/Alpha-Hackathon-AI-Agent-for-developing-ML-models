flowchart TD
    subgraph DEV["Подготовка и отправка вне запуска"]
        D1["ZIP: solution.py, корневые .py<br/>и фиксированный requirements.txt<br/>Промпты, схемы и настройки внутри Python<br/>Без библиотек, .whl и вложенных модулей"]
        D2["Проверить перенос и контракт baseline<br/>Только установленные пакеты, без MCP<br/>Образ Docker и ключ Qwen пока не получены<br/>Статический аудит не равен smoke-запуску"]
        D3["До 3 отправок в сутки команды<br/>Сброс 00:00 МСК; ждать score, включая ноль<br/>Private: сохранённый лучший public-код<br/>Без изменений и feedback внутри запуска"]
        D1 --> D2 --> D3
    end
    subgraph RT["Одна задача в Docker организаторов"]
        S["solution.py: t0 и супервизор до импортов<br/>Общий предел 10800 с; argv: task.md или путь<br/>Python 3.12, 8 CPU, 32 GB; один опыт<br/>Без GPU, root, своего или nested Docker"]
        G["Инвариант каждого узла «Шаг»<br/>Перед КАЖДЫМ вызовом: время, CPU, RAM, диск<br/>Timeout и bounded retry внутри остатка<br/>Запас на CSV и cleanup; cgroup не требуется"]
        SPEC["Шаг: текущие task.md и четыре CSV<br/>Тип, target, ID, формат, точная метрика<br/>Фактический словарь; текст и таблицы<br/>Без target-статистик до разделения"]
        C{"Выходной контракт<br/>однозначен и поддержан?"}
        RESOLVE["Шаг: ограниченный resolver<br/>Только текущие файлы; лимит попыток/времени<br/>Контракт либо точная метрика/адаптер<br/>Доверенный реестр/формулы; без proxy"]
        BASE["Шаг: константный форматный резерв<br/>Без fit и target-статистик train<br/>Константа из контракта/sample, не confirmation<br/>Проверить полный test CSV; score не обещать"]
        PUB["Шаг: первая атомарная публикация<br/>Проверенный temporary на той же ФС<br/>submission.csv рядом с solution.py/task.md<br/>Копия резерва; ошибка записи: bounded retry"]
        SPLIT["Шаг: сначала отделить confirmation<br/>Затем split поиска и профиль fit-части<br/>Время / группы / IID; seeds, классы<br/>Confirmation неизменен при смене split"]
        M{"Точная метрика и<br/>доверенный evaluator доступны?"}
        API["Шаг: проверить только Qwen3.8-27B<br/>OPENAI_MODEL / OPENAI_API_KEY<br/>OPENAI_BASE_URL; квоты и формат ответа<br/>Скрипт передаёт описания и схемы tools"]
        MODE{"Проверен native tools<br/>либо валидированный<br/>текстовый action-протокол?"}
        B{"Следующий шаг поиска помещается<br/>с запасом на завершение?<br/>Проверка повторяется внутри каждого «Шага»"}
        PLAN["Шаг: action и аргументы по журналу<br/>Qwen: draft / debug / improve<br/>Признаки, очистка, модели, ансамбли, split<br/>Local controller — явная деградация LLM"]
        CHECK["Шаг: скрипт проверяет action/аргументы<br/>Разрешённые данные, операции, пакеты<br/>Сложность, повторы, repair и квоты<br/>Модель сама инструмент не исполняет"]
        GEN["Шаг: компилятор создаёт Python<br/>Из проверенных исследовательских операций<br/>Новый split: переоценить соперников<br/>Не принимать произвольный Python модели"]
        RUN["Шаг: скрипт исполняет Python<br/>subprocess, cwd, потоки, timeout<br/>psutil и потомки — best effort<br/>Это не OS sandbox; один UID не защищает labels"]
        EVAL["Шаг: доверенный trainer / evaluator<br/>Сам управляет fit/predict по split<br/>Преобразования только по fit; сам метрика<br/>Не принимает score из stdout"]
        LOG["Шаг: обновить журнал и состояние<br/>Код, parent, гипотеза, split, score, ошибки<br/>Время, память, CSV; результат для модели<br/>Сам журнал не вызывает планировщик"]
        BETTER{"Завершённый корректный опыт<br/>продвигается по общему протоколу?"}
        TEST["Шаг: test predict и проверенный CSV<br/>Строки, ID, колонки, типы, конечность<br/>Классы / вероятности по контракту<br/>Сохранить CSV до продвижения кандидата"]
        PROMOTE["Шаг: продвинуть с готовым CSV<br/>Атомарно опубликовать лидера<br/>Хранить CSV всех продвинутых кандидатов<br/>Сбой записи: прежний валидный файл"]
        FREEZE{"Заморозить shortlist и настройки<br/>Есть оценённый кандидат<br/>с готовым CSV и точной метрикой?"}
        CONFQ{"Confirmation выделен и ещё не использован,<br/>есть данные и запас на всю проверку<br/>с последующим выбором и cleanup?"}
        CONF["Шаг: один confirmation замороженного списка<br/>Ранее не использован для обучения/поиска<br/>Только выбор фиксированных кандидатов<br/>Без возврата в адаптивный поиск"]
        SELECT["Шаг: выбрать финалиста с готовым CSV<br/>Проверить и атомарно опубликовать его CSV<br/>Сохранить копию до любого refit<br/>Сбой: откат к последнему валидному"]
        REFITQ{"Есть выбранный обучаемый рецепт<br/>и запас на refit, predict, проверку,<br/>публикацию и остановку?"}
        REFIT["Шаг: необязательный refit разрешённого train<br/>Новый временный CSV; watchdog<br/>Сбой / timeout: выбранный CSV остаётся<br/>Новой независимой оценки нет"]
        FINAL["Шаг: ограниченная финальная проверка<br/>Новый валидный CSV: atomic replace<br/>Иначе оставить сохранённый валидный<br/>Без метрики/кандидатов — только резерв"]
        CLEAN["Шаг: bounded cleanup и остановка потомков<br/>CSV и резерв не удалять<br/>Ошибка cleanup не отменяет готовый CSV<br/>Без новых fit, API и полной переоценки"]
        OUT["submission.csv существует до kill<br/>Рядом с solution.py и task.md<br/>Завершить до общего дедлайна<br/>Локальная метрика не score платформы"]
        FAIL["Явный неуспех: валидного CSV нет<br/>Контракт не разрешён / retry исчерпаны<br/>Bounded cleanup без обещания результата"]
        ERR{"Глобальный handler любого «Шага»<br/>Мягкая остановка / авария / retry исчерпаны<br/>Остановить активные работы; rollback<br/>Есть ранее проверенный валидный CSV?"}
        S --> SPEC --> C
        S -.->|Обязателен для каждого «Шага», включая API и retry| G
        G -.->|Глобальное прерывание любого этапа| ERR
        C -->|Да| BASE --> PUB --> SPLIT --> M
        C -->|Нет, попытки ещё есть| RESOLVE
        RESOLVE -->|Контракт разрешён| C
        RESOLVE -->|Точная метрика разрешена| M
        RESOLVE -->|Контракт не разрешён, лимит исчерпан| FAIL
        RESOLVE -->|Метрика не разрешена, лимит исчерпан| FINAL
        BASE -->|Невозможен допустимый резерв| FAIL
        M -->|Нет, попытки ещё есть| RESOLVE
        M -->|Да| API --> MODE
        MODE -->|Да: зафиксировать режим Qwen| B
        MODE -->|Нет: зафиксировать local-деградацию| B
        B -->|Да| PLAN --> CHECK
        CHECK -->|Принято| GEN --> RUN --> EVAL --> LOG --> BETTER
        CHECK -->|Отклонено / repair нужен| LOG
        RUN -->|Ошибка / timeout / OOM опыта| LOG
        BETTER -->|Да| TEST
        BETTER -->|Нет| B
        TEST -->|CSV готов| PROMOTE --> B
        TEST -->|Сбой: старый CSV остаётся| LOG
        B -->|Нет / остановить поиск| FREEZE
        FREEZE -->|Да| CONFQ
        FREEZE -->|Нет: резерв, без confirmation/refit| FINAL
        CONFQ -->|Да| CONF --> SELECT
        CONFQ -->|Нет: выбор по search-validation| SELECT
        SELECT --> REFITQ
        REFITQ -->|Да| REFIT --> FINAL
        REFITQ -->|Нет| FINAL
        FINAL --> CLEAN --> OUT
        ERR -->|Да: сохранить CSV, только cleanup| CLEAN
        ERR -->|Нет: до первой публикации| FAIL
    end
    D3 -->|Платформа: новый автономный запуск| S
